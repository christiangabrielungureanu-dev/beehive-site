---
const groups = [
  {
    icon: '🗺️',
    name: 'Marketing',
    tagline: 'A plan built for your book, and help carrying it out',
    href: '/services#marketing',
    options: [
      {
        name: 'Audit & Strategy',
        description:
          'I review everything you\'re doing to promote the book now, build a strategy around the readers it\'s for, and walk you through it on a call.',
      },
      {
        name: 'Assisted DIY',
        description:
          'The same strategy, plus weekly goals, check-ins, a call every two weeks, WhatsApp support, and a group of self-help authors to promote with.',
      },
    ],
  },
  {
    icon: '📚',
    name: 'Publishing & Distribution',
    tagline: 'Get the book out, everywhere your readers buy',
    href: '/services#publishing',
    options: [
      {
        name: 'Assisted DIY',
        description:
          'You publish it yourself, with a guide on platforms, listings, and pricing, and a review of every listing before it goes live.',
      },
      {
        name: 'Done-for-you',
        description:
          'Send me the finished manuscript. I handle the setup and get the book listed in the stores your readers use.',
      },
    ],
  },
];
---

<section class="services section" id="services">
  <div class="container">
    <!-- Section header -->
    <div class="services-header">
      <span class="section-eyebrow">What I Do</span>
      <h2 class="services-heading">Two ways I help your book reach its readers.</h2>
      <p class="services-sub">
        Market the book with a strategy built for it, or get it published first. Or both.
      </p>
    </div>

    <!-- Groups grid -->
    <div class="services-grid">
      {groups.map(group => (
        <div class="service-card card">
          <div class="service-icon" aria-hidden="true">{group.icon}</div>
          <h3 class="service-name">{group.name}</h3>
          <p class="service-tagline">{group.tagline}</p>

          <ul class="service-options">
            {group.options.map(option => (
              <li class="service-option">
                <span class="service-option-name">{option.name}</span>
                <p class="service-option-desc">{option.description}</p>
              </li>
            ))}
          </ul>

          <a href={group.href} class="service-link">
            See what's included <span aria-hidden="true">→</span>
          </a>
        </div>
      ))}
    </div>

    <!-- Footer CTA -->
    <div class="services-footer">
      <a href="/contact" class="btn-primary">
        Book a Call <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .services {
    background: #fff;
  }

  /* Header */
  .services-header {
    text-align: center;
    margin-bottom: 3rem;
    max-width: 720px;
    margin-inline: auto;
  }

  .section-eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #E0941A;
    margin-bottom: 0.625rem;
  }

  .services-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    font-weight: 700;
    color: #3A3530;
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .services-sub {
    font-size: 1.0625rem;
    color: #6B7280;
    margin: 0;
    line-height: 1.6;
  }

  /* Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    align-items: stretch;
  }

  /* Card */
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2rem;
  }

  /* Content */
  .service-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .service-name {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    color: #3A3530;
    margin: 0 0 0.25rem;
  }

  .service-tagline {
    font-size: 0.875rem;
    font-weight: 600;
    color: #E0941A;
    margin: 0 0 0.875rem;
  }

  /* Options */
  .service-options {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .service-option {
    border-left: 3px solid #E0941A;
    padding-left: 1rem;
  }

  .service-option-name {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #3A3530;
    margin-bottom: 0.25rem;
  }

  .service-option-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: #4B5563;
    margin: 0;
  }

  .service-link {
    margin-top: auto;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #E0941A;
    text-decoration: none;
  }

  .service-link:hover { text-decoration: underline; }

  /* Footer */
  .services-footer {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  @media (max-width: 760px) {
    .services-grid {
      grid-template-columns: 1fr;
      max-width: 520px;
      margin-inline: auto;
    }
  }
</style>

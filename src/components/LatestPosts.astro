---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<section class="posts section" id="blog">
  <div class="container">
    <!-- Section header -->
    <div class="posts-header">
      <div class="posts-header-text">
        <span class="section-eyebrow">The Hive Mind</span>
        <h2 class="posts-heading">From the Blog</h2>
        <p class="posts-sub">Conversations with authors, marketers, and operators on turning a book into a business asset that pays — in pipeline, deals, and stages.</p>
      </div>
      <a href="/blog" class="posts-see-all">
        See All Articles <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Post cards -->
    {posts.length > 0 ? (
      <div class="posts-grid">
        {posts.map(post => (
          <a href={`/blog/${post.id}/`} class="post-card card">
            <!-- Cover image -->
            <div class="post-thumb">
              {post.data.ogImage ? (
                <img src={post.data.ogImage} alt="" class="post-thumb-img" loading="lazy" />
              ) : (
                <div class="post-thumb-placeholder" />
              )}
            </div>

            <!-- Meta -->
            <div class="post-meta">
              <time class="post-date" datetime={post.data.publishDate.toISOString()}>
                {formatDate(post.data.publishDate)}
              </time>
            </div>

            <h3 class="post-title">{post.data.title}</h3>

            {post.data.guestName && (
              <p class="post-guest">
                <span class="post-guest-label">Guest:</span> {post.data.guestName}
              </p>
            )}

            <p class="post-desc">{post.data.description}</p>
          </a>
        ))}
      </div>
    ) : (
      <p class="posts-empty">No articles yet.</p>
    )}

    <!-- Mobile see all -->
    <div class="posts-mobile-cta">
      <a href="/blog" class="btn-primary">See All Articles →</a>
    </div>
  </div>
</section>

<style>
  .posts {
    background: #FFF8EC;
  }

  /* Header */
  .posts-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .section-eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #E0941A;
    margin-bottom: 0.625rem;
  }

  .posts-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    font-weight: 700;
    color: #3A3530;
    margin: 0 0 0.5rem;
  }

  .posts-sub {
    font-size: 1rem;
    color: #6B7280;
    margin: 0;
    max-width: 50ch;
  }

  .posts-see-all {
    flex-shrink: 0;
    font-weight: 600;
    font-size: 0.9375rem;
    color: #E0941A;
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s;
  }

  .posts-see-all:hover {
    border-color: #E0941A;
  }

  /* Grid */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* Card */
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0;
    text-decoration: none;
    color: inherit;
    background: #fff;
    overflow: hidden;
    padding: 0;
  }

  /* Thumbnail */
  .post-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0.75rem 0.75rem 0 0;
  }

  .post-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }

  .post-card:hover .post-thumb-img {
    transform: scale(1.02);
  }

  .post-thumb-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #E0941A 0%, #F9D14B 60%, #C6820E 100%);
  }

  /* Card content */
  .post-meta {
    padding: 1rem 1.25rem 0;
  }

  .post-date {
    font-size: 0.75rem;
    color: #9CA3AF;
  }

  .post-title {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    color: #3A3530;
    line-height: 1.35;
    margin: 0.625rem 1.25rem 0.5rem;
  }

  .post-guest {
    font-size: 0.8125rem;
    color: #6B7280;
    margin: 0 1.25rem 0.625rem;
  }

  .post-guest-label {
    font-weight: 600;
    color: #374151;
  }

  .post-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #4B5563;
    margin: 0 1.25rem 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  /* Empty / mobile */
  .posts-empty {
    text-align: center;
    color: #6B7280;
    padding: 3rem 0;
  }

  .posts-mobile-cta {
    display: none;
    justify-content: center;
    margin-top: 2rem;
  }

  @media (max-width: 960px) {
    .posts-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin-inline: auto;
    }

    .posts-see-all {
      display: none;
    }

    .posts-mobile-cta {
      display: flex;
    }
  }

  @media (min-width: 640px) and (max-width: 960px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
      max-width: 100%;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';

const siteUrl = Astro.site?.href ?? 'https://beehivebookmarketing.com/';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/about', Astro.site).href,
  name: 'Cristian Ungureanu',
  url: new URL('/about', Astro.site).href,
  image: new URL('/cristian-pic.jpg', Astro.site).href,
  jobTitle: 'Founder',
  description: 'Founder of Beehive Book Marketing. Helps self-help authors market, publish, and distribute their books.',
  sameAs: ['https://www.linkedin.com/in/cristian-ungureanu/'],
  worksFor: {
    '@type': 'Organization',
    name: 'Beehive Book Marketing',
    url: siteUrl,
  },
};
---

<BaseLayout
  title="About Cristian Ungureanu — Beehive Book Marketing"
  description="Cristian Ungureanu helps self-help authors market, publish, and distribute their books so they reach the readers they were written for."
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <!-- Hero -->
  <section class="about-hero section">
    <div class="container about-hero-inner">
      <div class="about-hero-content">
        <span class="eyebrow">The Person Behind the Work</span>
        <h1 class="about-hero-heading">
          I spent 8 years getting products in front of people.<br />
          <em class="accent">Now I do it for books.</em>
        </h1>
        <p class="about-hero-sub">
          My name is Cristian Ungureanu. I run Beehive — marketing and publishing help for
          self-help authors, built on one idea: the hard part isn't writing the book, it's
          getting it to the readers it was written for.
        </p>
      </div>
      <div class="about-hero-photo">
        <img src="/cristian-pic.jpg" alt="Cristian Ungureanu, founder of Beehive Book Marketing" class="about-photo-img" />
        <div class="about-photo-card">
          <span class="about-photo-name">Cristian Ungureanu</span>
          <span class="about-photo-title">FOUNDER — BEEHIVE BOOK MARKETING</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Background -->
  <section class="section about-bg-section">
    <div class="container about-content-grid">
      <div class="about-sidebar">
        <div class="about-stat-stack">
          <div class="about-stat-card">
            <span class="about-stat-num">Strategy</span>
            <span class="about-stat-desc">A marketing plan built for your book and its readers</span>
          </div>
          <div class="about-stat-card">
            <span class="about-stat-num">Support</span>
            <span class="about-stat-desc">Weekly goals, regular calls, and help on WhatsApp</span>
          </div>
          <div class="about-stat-card">
            <span class="about-stat-num">Publishing</span>
            <span class="about-stat-desc">From finished manuscript to the stores your readers use</span>
          </div>
        </div>
      </div>

      <div class="about-body">
        <h2 class="about-section-heading">My Background</h2>
        <p>
          Before Beehive, I worked in marketing across hospitality and SaaS — most recently at
          <strong>QuickMail.io</strong> and <strong>ScraperAPI.com</strong>, where I built demand
          generation from the ground up: content, SEO, outbound, paid, partnerships.
        </p>
        <p>
          The lesson that carried over wasn't a framework. It was that good marketing is mostly
          a clear plan, followed week after week. The companies that grew weren't the ones doing
          the most. They were the ones that picked the few right things and kept doing them.
        </p>
        <p>
          When I started paying attention to self-help publishing, that's exactly what was
          missing. Good books, and authors with no clear plan for getting them read — trying
          everything at once or nothing at all, and usually doing it alone.
        </p>
        <p>
          That gap is where Beehive lives.
        </p>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="section about-philosophy">
    <div class="container">
      <div class="about-philosophy-header">
        <span class="eyebrow">How I Think</span>
        <h2 class="about-section-heading">How I Work</h2>
      </div>

      <div class="philosophy-grid">
        <div class="philosophy-card">
          <span class="philosophy-icon">🗺️</span>
          <h3>A plan built for your book</h3>
          <p>
            No templates. The strategy comes from your book, your readers, and what you've
            already tried, so you don't spend months on channels that were never going to fit.
          </p>
        </div>
        <div class="philosophy-card">
          <span class="philosophy-icon">📖</span>
          <h3>The right readers, not the most readers</h3>
          <p>
            A small audience that's exactly right for your book will do more for you than a big
            one that isn't. Reach that doesn't match is just noise.
          </p>
        </div>
        <div class="philosophy-card">
          <span class="philosophy-icon">🐝</span>
          <h3>Authors help authors</h3>
          <p>
            The strongest promotion for a self-help book is another self-help author with the
            same readers. The author group is there so you can share what's working and promote
            each other's books.
          </p>
        </div>
        <div class="philosophy-card">
          <span class="philosophy-icon">📬</span>
          <h3>You'll always know what's next</h3>
          <p>
            Weekly goals, regular check-ins, and a call every two weeks. No guessing what to
            work on, and no going quiet.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Books -->
  <section class="section about-why">
    <div class="container about-why-inner">
      <div class="about-why-content">
        <span class="eyebrow">Why This</span>
        <h2 class="about-section-heading">
          Why Self-Help
        </h2>
        <p>
          The honest answer: these books matter in a way most books don't. Someone picks up a
          self-help book at a genuinely bad moment — a marriage coming apart, a career they can't
          stand, a habit they can't break — and occasionally the right one changes what happens
          next.
        </p>
        <p>
          But most of them never reach that person. Not because they aren't good. Because the
          author didn't have a plan for getting the book read, or anyone to help carry it out.
        </p>
        <p>
          That's the problem I want to solve. I want to be the person a self-help author calls
          when they've written something worth reading and don't know who to tell.
        </p>
        <a href="/contact" class="btn-primary" style="display:inline-flex;margin-top:1.5rem;">
          Let's talk about your book →
        </a>
      </div>
      <div class="about-why-quote">
        <blockquote class="about-pullquote">
          <span class="about-pullquote-mark" aria-hidden="true">&ldquo;</span>
          <p>The hardest part of a self-help book isn't writing it. It's getting it to the person who needed it that week.</p>
          <footer>
            <span class="about-pullquote-name">Cristian Ungureanu</span>
            <span class="about-pullquote-title">Founder, Beehive Book Marketing</span>
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  /* Shared */
  .eyebrow {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #E0941A;
    margin-bottom: 0.625rem;
  }

  .accent { font-style: italic; color: #E0941A; }

  .about-section-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.625rem, 2.5vw, 2.25rem);
    font-weight: 700;
    color: #3A3530;
    margin: 0 0 1.5rem;
  }

  /* Hero */
  .about-hero { background: linear-gradient(135deg, #FFFDF7 0%, #FFF8EC 100%); }

  .about-hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4rem;
  }

  .about-hero-heading {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 700;
    color: #3A3530;
    line-height: 1.2;
    margin: 0.5rem 0 1.25rem;
  }

  .about-hero-sub {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #4B5563;
    margin: 0;
  }

  /* Photo */
  .about-hero-photo { position: relative; }

  .about-photo-placeholder {
    aspect-ratio: 4/5;
    border-radius: 1.5rem;
    background: linear-gradient(145deg, #E0941A 0%, #F9D14B 50%, #C6820E 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-photo-initials {
    font-family: var(--font-heading);
    font-size: 5rem;
    font-weight: 700;
    color: rgba(255,255,255,0.55);
  }

  .about-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 1.5rem;
    display: block;
  }

  .about-photo-card {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(8px);
    border-radius: 0.75rem;
    padding: 0.75rem 1.5rem;
    box-shadow: 0 4px 24px rgba(0,0,0,0.12);
    white-space: nowrap;
  }

  .about-photo-name {
    font-family: var(--font-script);
    font-size: 1.375rem;
    color: #3A3530;
  }

  .about-photo-title {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #E0941A;
    text-transform: uppercase;
  }

  /* Background section */
  .about-bg-section { background: #fff; }

  .about-content-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 4rem;
    align-items: start;
  }

  .about-stat-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 5.5rem;
  }

  .about-stat-card {
    background: #FFF8EC;
    border: 1px solid rgba(224,148,26,0.2);
    border-radius: 0.875rem;
    padding: 1.25rem;
  }

  .about-stat-num {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    color: #E0941A;
    margin-bottom: 0.25rem;
  }

  .about-stat-desc {
    font-size: 0.8125rem;
    color: #6B7280;
    line-height: 1.4;
  }

  .about-body p {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: #374151;
    margin: 0 0 1.25rem;
  }

  .about-body strong { color: #3A3530; font-weight: 600; }

  /* Philosophy */
  .about-philosophy { background: #FFF8EC; }

  .about-philosophy-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .philosophy-card {
    background: #fff;
    border: 1px solid #E5E7EB;
    border-radius: 1rem;
    padding: 1.75rem;
  }

  .philosophy-icon { font-size: 1.75rem; display: block; margin-bottom: 1rem; }

  .philosophy-card h3 {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: #3A3530;
    margin: 0 0 0.625rem;
  }

  .philosophy-card p {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #4B5563;
    margin: 0;
  }

  /* Why books */
  .about-why { background: #fff; }

  .about-why-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .about-why-content p {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: #374151;
    margin: 0 0 1.25rem;
  }

  /* Pull quote */
  .about-pullquote {
    position: relative;
    background: #3A3530;
    border-radius: 1.25rem;
    padding: 2.5rem 2rem 2rem;
    margin: 0;
  }

  .about-pullquote-mark {
    position: absolute;
    top: 1rem;
    left: 1.5rem;
    font-family: Georgia, serif;
    font-size: 4rem;
    color: #E0941A;
    opacity: 0.4;
    line-height: 1;
  }

  .about-pullquote p {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.6;
    color: #fff;
    margin: 0 0 1.5rem;
  }

  .about-pullquote footer {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .about-pullquote-name {
    font-family: var(--font-script);
    font-size: 1.25rem;
    color: #E0941A;
  }

  .about-pullquote-title {
    font-size: 0.75rem;
    color: #6B7280;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  /* Responsive */
  @media (max-width: 960px) {
    .about-hero-inner,
    .about-why-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .about-content-grid { grid-template-columns: 1fr; }
    .about-stat-stack { position: static; flex-direction: row; flex-wrap: wrap; }
    .about-stat-card { flex: 1; min-width: 140px; }
    .philosophy-grid { grid-template-columns: 1fr; }
  }
</style>

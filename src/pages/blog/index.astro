---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<BaseLayout
  title="Blog — Reaching Readers in Self-Help"
  description="Conversations with self-help authors and with the hosts, editors, and operators who decide who reaches their audience."
>
  <section class="blog-hero section">
    <div class="container blog-hero-inner">
      <span class="eyebrow">The Hive</span>
      <h1 class="blog-hero-heading">
        Notes on<br />
        <em class="accent">getting a book heard</em>
      </h1>
      <p class="blog-hero-sub">
        Written from conversations with authors, and with the podcast hosts, newsletter
        operators, and editors on the other side of the pitch.
      </p>
    </div>
  </section>

  <section class="section blog-list-section">
    <div class="container">
      {posts.length > 0 ? (
        <div class="blog-list">
          {posts.map(post => (
            <a href={`/blog/${post.id}`} class="blog-list-item">
              {post.data.coverImage && (
                <img src={post.data.coverImage} alt="" class="blog-list-cover" loading="lazy" />
              )}
              <div class="blog-list-body">
                <time class="blog-list-date" datetime={post.data.publishDate.toISOString()}>
                  {formatDate(post.data.publishDate)}
                </time>
                <h2 class="blog-list-title">{post.data.title}</h2>
                <p class="blog-list-desc">{post.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="blog-empty">Articles are on the way. In the meantime, the conversations behind them are <a href="/podcast">on the podcast</a>.</p>
      )}
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .eyebrow {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #E0941A;
    margin-bottom: 0.625rem;
  }

  .accent { font-style: italic; color: #E0941A; }

  .blog-hero {
    background: linear-gradient(135deg, #FFFDF7 0%, #FFF8EC 100%);
    text-align: center;
  }

  .blog-hero-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .blog-hero-heading {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    color: #3A3530;
    margin: 0.5rem 0 1.25rem;
    line-height: 1.15;
  }

  .blog-hero-sub {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #4B5563;
    max-width: 56ch;
    margin: 0 auto;
  }

  .blog-list-section {
    background: #fff;
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .blog-list-item {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 1.5rem;
    align-items: center;
    background: #FFF8EC;
    border: 1px solid rgba(224,148,26,0.15);
    border-radius: 1rem;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .blog-list-item:hover {
    border-color: rgba(224,148,26,0.4);
    box-shadow: 0 8px 24px rgba(0,0,0,0.05);
  }

  .blog-list-cover {
    width: 220px;
    aspect-ratio: 16 / 9;
    border-radius: 0.625rem;
    object-fit: cover;
    object-position: left center;
    display: block;
  }

  .blog-list-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .blog-list-date {
    font-size: 0.8125rem;
    color: #6B7280;
    font-weight: 500;
  }

  .blog-list-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: #3A3530;
    margin: 0;
    line-height: 1.3;
  }

  .blog-list-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #4B5563;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-empty {
    text-align: center;
    color: #6B7280;
    font-size: 1rem;
    padding: 2rem 0;
  }

  .blog-empty a {
    color: #E0941A;
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid rgba(224,148,26,0.3);
  }

  .blog-empty a:hover { border-bottom-color: #E0941A; }

  @media (max-width: 600px) {
    .blog-list-item {
      grid-template-columns: 1fr;
    }
    .blog-list-cover {
      width: 100%;
      aspect-ratio: 16 / 9;
    }
  }
</style>

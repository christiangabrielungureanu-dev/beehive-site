---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
---

<BaseLayout
  title="Marketing & Publishing for Self-Help Authors — Beehive"
  description="Marketing strategy, weekly support, and publishing help for self-help authors — so your book reaches the readers it was written for."
>
  <!-- Hero -->
  <section class="services-hero section">
    <div class="container services-hero-inner">
      <span class="eyebrow">How I Work</span>
      <h1 class="services-hero-heading">
        Everything your book needs<br />
        <em class="accent">to reach its readers.</em>
      </h1>
      <p class="services-hero-sub">
        I help self-help authors in two ways: a marketing plan built for your book, with
        support to carry it out, and help getting the book published and into the stores your
        readers use.
      </p>
    </div>
  </section>

  <!-- Marketing -->
  <section class="section group-header-section" id="marketing">
    <div class="container group-header">
      <span class="eyebrow">Marketing</span>
      <h2 class="group-heading">
        Get your book in front of <em class="accent">the readers it was written for.</em>
      </h2>
      <p class="group-sub">
        Start with a strategy. Carry it out yourself, or carry it out with me alongside you.
      </p>
    </div>
  </section>

  <!-- Audit & Strategy -->
  <section class="section tier-section tier-section--light" id="strategy">
    <div class="container tier-inner">
      <div class="tier-content">
        <span class="eyebrow">01</span>
        <h3 class="tier-heading">Audit & Strategy</h3>
        <p class="tier-tagline">A clear plan for reaching your readers.</p>
        <p class="tier-body">
          I look at your book, the readers it's for, and everything you're doing to promote it
          right now. Then I build a strategy around what I find: where to focus, in what order,
          and what to do first. I present it to you on a call and answer every question you have.
        </p>

        <h4 class="tier-includes-heading">What's included</h4>
        <ul class="tier-list">
          <li>An audit of your current marketing: website, book listings, newsletter, social, and any press so far</li>
          <li>A written strategy built for your book and its readers</li>
          <li>A call where I walk you through it and take your questions</li>
          <li>A plan that's yours to keep and carry out</li>
        </ul>

        <div class="tier-ideal">
          <strong>What you get:</strong> A clear answer to "what should I be doing to market
          this book?", with a plan to match.
        </div>

        <a href="/contact" class="btn-primary" style="display:inline-flex;margin-top:1.5rem;">
          Book a Call →
        </a>
      </div>
      <div class="tier-visual tier-visual--diy" aria-hidden="true">
        <span class="tier-icon">🗺️</span>
        <div class="dfy-steps">
          {['Audit', 'Strategy', 'Walkthrough call'].map((step, i) => (
            <div class="dfy-step">
              <span class="dfy-step-num">{i + 1}</span>
              <span class="dfy-step-label">{step}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Assisted DIY -->
  <section class="section tier-section tier-section--warm" id="assisted-diy">
    <div class="container tier-inner tier-inner--reverse">
      <div class="tier-visual tier-visual--consulting" aria-hidden="true">
        <span class="tier-icon">🐝</span>
        <div class="dfy-steps">
          {['Weekly goals', 'Check-ins', 'Calls every two weeks', 'WhatsApp support', 'Author group'].map((step, i) => (
            <div class="dfy-step">
              <span class="dfy-step-num">{i + 1}</span>
              <span class="dfy-step-label">{step}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="tier-content">
        <span class="eyebrow">02</span>
        <h3 class="tier-heading">Assisted DIY</h3>
        <p class="tier-tagline">You do the work. I keep you on track.</p>
        <p class="tier-body">
          A strategy is easy to agree with and hard to keep up on your own. Assisted DIY starts
          with the same audit and strategy, then I stay with you while you carry it out: setting
          goals each week, checking in on how they went, and helping when you get stuck.
        </p>

        <h4 class="tier-includes-heading">What's included</h4>
        <ul class="tier-list">
          <li>The full audit and strategy</li>
          <li>Weekly goals and a weekly check-in</li>
          <li>A call every two weeks</li>
          <li>Support on WhatsApp between calls</li>
          <li>A group of self-help authors to share what's working and promote each other's books</li>
        </ul>

        <div class="tier-ideal">
          <strong>What you get:</strong> Steady progress on your book's marketing, with
          someone in your corner every week.
        </div>

        <a href="/contact" class="btn-primary" style="display:inline-flex;margin-top:1.5rem;">
          Book a Call →
        </a>
      </div>
    </div>
  </section>

  <!-- Publishing & Distribution -->
  <section class="section tier-section tier-section--dark" id="publishing">
    <div class="container">
      <div class="group-header">
        <span class="eyebrow eyebrow--amber">Publishing & Distribution</span>
        <h2 class="group-heading group-heading--light">
          Get the book out, <em class="accent">everywhere your readers buy.</em>
        </h2>
        <p class="group-sub group-sub--light">
          Not published yet? Do it yourself with a guide, or hand it over to me.
        </p>
      </div>

      <div class="pub-grid">
        <div class="pub-card">
          <span class="eyebrow eyebrow--amber">03</span>
          <h3 class="tier-heading tier-heading--light">Assisted DIY</h3>
          <p class="tier-tagline tier-tagline--amber">Publish it yourself, with a guide at every step.</p>
          <p class="tier-body tier-body--light">
            You keep control of every account and every decision. I walk you through the choices
            that trip most authors up — where to publish, how to set up your listings, what to
            price at — and check your work before it goes live.
          </p>
          <ul class="tier-list tier-list--light">
            <li>A publishing plan: platforms, formats, and timeline</li>
            <li>Guidance on ISBNs, Amazon KDP, IngramSpark, and going wide</li>
            <li>Help with your book description, categories, and keywords</li>
            <li>A review of every listing before it goes live</li>
            <li>Check-ins and calls along the way</li>
          </ul>
          <a href="/contact" class="btn-primary" style="display:inline-flex;margin-top:auto;">
            Book a Call →
          </a>
        </div>

        <div class="pub-card">
          <span class="eyebrow eyebrow--amber">04</span>
          <h3 class="tier-heading tier-heading--light">Done-for-you</h3>
          <p class="tier-tagline tier-tagline--amber">Hand it over. I'll get it published.</p>
          <p class="tier-body tier-body--light">
            You send the finished manuscript. I handle the setup, coordinate the specialists, and
            get the book listed in the stores your readers use — then hand everything over to you.
          </p>
          <ul class="tier-list tier-list--light">
            <li>Platform setup and uploads for ebook, paperback, and hardcover</li>
            <li>Book description, categories, and keywords written for you</li>
            <li>Formatting and cover handled through vetted specialists</li>
            <li>Distribution to major online retailers and libraries</li>
            <li>Every account in your name, handed over at the end</li>
          </ul>
          <a href="/contact" class="btn-primary" style="display:inline-flex;margin-top:auto;">
            Book a Call →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section services-faq">
    <div class="container">
      <div class="faq-header">
        <span class="eyebrow">Common Questions</span>
        <h2 class="faq-heading">Frequently Asked</h2>
      </div>
      <div class="faq-grid">
        {[
          {
            q: 'How much does it cost?',
            a: 'It depends on what you need. I\'ll walk you through the options and pricing on the call. If budget is tight, say so — I can take parts out of the plan so it costs less.',
          },
          {
            q: 'Can I just get the strategy?',
            a: 'Yes. The audit and strategy stands on its own: you get the plan and the walkthrough call, and carry it out however you like. If you want support later, it\'s the first step of Assisted DIY anyway.',
          },
          {
            q: 'Do I need a finished book to work with you?',
            a: 'No. If the book isn\'t out yet, I can help you publish it. And marketing works better started early — a lot of what helps a launch has to be set up before it.',
          },
          {
            q: 'What kinds of authors do you work with?',
            a: 'Self-help authors. Traditionally published, hybrid, and self-published authors all have the same underlying problem: getting the book in front of the people it was written for.',
          },
          {
            q: 'Do you work with authors outside the US?',
            a: 'Yes. I\'m based in Italy and work with English-language authors everywhere.',
          },
          {
            q: 'What does the call involve?',
            a: 'A conversation about your book, who it\'s for, and where you\'re trying to get. If I\'m not the right person, I\'ll tell you, and where I can I\'ll point you at who is.',
          },
        ].map(item => (
          <div class="faq-item">
            <h3 class="faq-q">{item.q}</h3>
            <p class="faq-a">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .eyebrow {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #E0941A;
    margin-bottom: 0.625rem;
  }

  .eyebrow--amber { color: #E0941A; }
  .accent { font-style: italic; color: #E0941A; }

  /* Hero */
  .services-hero { background: linear-gradient(135deg, #FFFDF7 0%, #FFF8EC 100%); text-align: center; }

  .services-hero-heading {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 700;
    color: #3A3530;
    margin: 0.5rem auto 1.25rem;
    line-height: 1.15;
  }

  .services-hero-sub {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #4B5563;
    max-width: 52ch;
    margin: 0 auto;
  }

  /* Group headers */
  .group-header-section { background: #fff; padding-bottom: 0; }

  .group-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3rem;
  }

  .group-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    font-weight: 700;
    color: #3A3530;
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .group-heading--light { color: #fff; }

  .group-sub {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #6B7280;
    margin: 0;
  }

  .group-sub--light { color: #D1D5DB; }

  /* Tier sections */
  .tier-section--light { background: #fff; }
  .tier-section--warm { background: #FFF8EC; }
  .tier-section--dark { background: #3A3530; }

  .tier-inner {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 4rem;
    align-items: center;
  }

  .tier-inner--reverse { grid-template-columns: 380px 1fr; }

  /* Tier content */
  .tier-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: #3A3530;
    margin: 0 0 0.25rem;
  }

  .tier-heading--light { color: #fff; }

  .tier-tagline {
    font-size: 1rem;
    font-weight: 600;
    color: #E0941A;
    margin: 0 0 1rem;
  }

  .tier-tagline--amber { color: #E0941A; }

  .tier-body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #374151;
    margin: 0 0 1.5rem;
  }

  .tier-body--light { color: #D1D5DB; }

  .tier-includes-heading {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: #3A3530;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tier-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tier-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: 0.9375rem;
    color: #374151;
  }

  .tier-list li::before {
    content: '✓';
    color: #E0941A;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 0.05em;
  }

  .tier-list--light li { color: #D1D5DB; }

  .tier-ideal {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #6B7280;
    background: #F9FAFB;
    border-left: 3px solid #E0941A;
    border-radius: 0 0.5rem 0.5rem 0;
    padding: 0.875rem 1rem;
  }

  .tier-ideal strong { color: #3A3530; }

  /* Visuals */
  .tier-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    border-radius: 1.5rem;
    padding: 3rem 2rem;
    min-height: 280px;
  }

  .tier-visual--diy { background: #FFF8EC; border: 2px dashed rgba(224,148,26,0.3); }
  .tier-visual--consulting { background: #fff; border: 1px solid #E5E7EB; box-shadow: 0 4px 24px rgba(0,0,0,0.05); }

  .tier-icon { font-size: 3.5rem; }

  /* Steps */
  .dfy-steps {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 100%;
    max-width: 240px;
  }

  .dfy-step {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 1rem;
    background: #fff;
    border: 1px solid rgba(224,148,26,0.2);
    border-radius: 0.5rem;
  }

  .tier-visual--consulting .dfy-step { background: #FFF8EC; }

  .dfy-step-num {
    width: 1.5rem;
    height: 1.5rem;
    background: #E0941A;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .dfy-step-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #3A3530;
  }

  /* Publishing cards */
  .pub-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .pub-card {
    display: flex;
    flex-direction: column;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 1.5rem;
    padding: 2.25rem;
  }

  /* FAQ */
  .services-faq { background: #fff; }

  .faq-header { text-align: center; margin-bottom: 3rem; }

  .faq-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    font-weight: 700;
    color: #3A3530;
    margin: 0;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .faq-item {
    background: #FFF8EC;
    border: 1px solid rgba(224,148,26,0.15);
    border-radius: 1rem;
    padding: 1.75rem;
  }

  .faq-q {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    color: #3A3530;
    margin: 0 0 0.75rem;
  }

  .faq-a {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #4B5563;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 960px) {
    .tier-inner,
    .tier-inner--reverse { grid-template-columns: 1fr; gap: 2.5rem; }
    .tier-inner--reverse .tier-visual { order: -1; }
    .pub-grid,
    .faq-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 540px) {
    .pub-card { padding: 1.75rem; }
  }
</style>

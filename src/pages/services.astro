---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
---

<BaseLayout
  title="Placements & Introductions for Self-Help Authors — Beehive"
  description="Podcast bookings, newsletter features, and blog placements for self-help authors — plus introductions to the people who can help you reach readers."
>
  <!-- Hero -->
  <section class="services-hero section">
    <div class="container services-hero-inner">
      <span class="eyebrow">How I Work</span>
      <h1 class="services-hero-heading">
        Three ways to get your book<br />
        <em class="accent">in front of new readers.</em>
      </h1>
      <p class="services-hero-sub">
        Your ideal readers already follow podcasts, newsletters, and blogs in self-help.
        I get you booked and featured there — and connected to the people who can help you
        promote the book.
      </p>
    </div>
  </section>

  <!-- Placements -->
  <section class="section tier-section tier-section--light" id="placements">
    <div class="container tier-inner">
      <div class="tier-content">
        <span class="eyebrow">01</span>
        <h2 class="tier-heading">Placements</h2>
        <p class="tier-tagline">Get booked where your readers already are.</p>
        <p class="tier-body">
          Most authors pitch cold, to a list, with the same email — and hosts can spot it in
          one line. I pitch hosts who know me, and only to shows where you're genuinely a fit
          for their audience. That's why the pitches land.
        </p>

        <h3 class="tier-includes-heading">What's included</h3>
        <ul class="tier-list">
          <li>Podcast bookings — pitching, negotiation, scheduling</li>
          <li>Newsletter features and swaps</li>
          <li>Blog and guest column placements</li>
          <li>A pitch written for each specific host, not a template</li>
          <li>A prep brief before every recording — the host's format, audience, what they've covered, what they'll likely ask</li>
          <li>Follow-up after the episode airs</li>
        </ul>

        <div class="tier-ideal">
          <strong>What you get:</strong> Interviews and features in front of audiences who
          already trust the person introducing you — and a set of hosts who now know your name.
        </div>

        <a href="/contact" class="btn-primary" style="display:inline-flex;margin-top:1.5rem;">
          Book a Call →
        </a>
      </div>
      <div class="tier-visual tier-visual--diy" aria-hidden="true">
        <span class="tier-icon">🎙️</span>
        <span class="tier-visual-label">Reach</span>
      </div>
    </div>
  </section>

  <!-- Introductions -->
  <section class="section tier-section tier-section--warm" id="introductions">
    <div class="container tier-inner tier-inner--reverse">
      <div class="tier-visual tier-visual--consulting" aria-hidden="true">
        <span class="tier-icon">🤝</span>
        <span class="tier-visual-label">Connections</span>
      </div>
      <div class="tier-content">
        <span class="eyebrow">02</span>
        <h2 class="tier-heading">Introductions</h2>
        <p class="tier-tagline">The right people for your book, fast.</p>
        <p class="tier-body">
          Placement isn't always the thing you need. Sometimes it's a publicist, a launch
          strategist, someone who runs ads for books, a cover designer, or another author whose
          audience overlaps with yours. I make the introduction — so you skip months of
          figuring out who's real.
        </p>

        <h3 class="tier-includes-heading">What's included</h3>
        <ul class="tier-list">
          <li>Warm introductions to operators and partners in self-help</li>
          <li>Vetted referrals for work outside my scope</li>
          <li>Introductions to other authors for cross-promotion</li>
          <li>Any referral relationship disclosed to you before it happens</li>
        </ul>

        <div class="tier-ideal">
          <strong>What you get:</strong> The right person, quickly, without spending three
          months finding out who's real.
        </div>

        <a href="/contact" class="btn-primary" style="display:inline-flex;margin-top:1.5rem;">
          Book a Call →
        </a>
      </div>
    </div>
  </section>

  <!-- The Author Network -->
  <section class="section tier-section tier-section--dark" id="author-network">
    <div class="container tier-inner">
      <div class="tier-content tier-content--dark">
        <span class="eyebrow eyebrow--amber">03</span>
        <h2 class="tier-heading tier-heading--light">The Author Network</h2>
        <p class="tier-tagline tier-tagline--amber">Get promoted by authors with your readers.</p>
        <p class="tier-body tier-body--light">
          The strongest promotion for a self-help book is another self-help author with the
          same readers. Members swap newsletters, guest on each other's platforms, and show up
          for each other's launches.
        </p>

        <h3 class="tier-includes-heading tier-includes-heading--light">What's included</h3>
        <ul class="tier-list tier-list--light">
          <li>Newsletter and audience swaps</li>
          <li>Guest appearances on each other's platforms</li>
          <li>Launch support from authors who've been through it</li>
          <li>Ongoing access, not just during a campaign</li>
        </ul>

        <div class="tier-ideal tier-ideal--dark">
          <strong>What you get:</strong> A set of people who'll help the next book too.
          <br /><br />
          <strong>One rule:</strong> promotion only, never reviews. Reciprocal review
          arrangements break Amazon's terms and the risk lands on the author's account, not
          mine. I won't organise them.
        </div>

        <a href="/contact" class="btn-primary" style="display:inline-flex;margin-top:1.5rem;">
          Book a Call →
        </a>
      </div>

      <div class="tier-visual tier-visual--dfy" aria-hidden="true">
        <span class="tier-icon">🐝</span>
        <span class="tier-visual-label tier-visual-label--light">How it works</span>
        <div class="dfy-steps">
          {['Talk', 'Match', 'Pitch', 'Record'].map((step, i) => (
            <div class="dfy-step">
              <span class="dfy-step-num">{i + 1}</span>
              <span class="dfy-step-label">{step}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section services-faq">
    <div class="container">
      <div class="faq-header">
        <span class="eyebrow">Common Questions</span>
        <h2 class="faq-heading">Frequently Asked</h2>
      </div>
      <div class="faq-grid">
        {[
          {
            q: 'Do I need a finished book to work with you?',
            a: 'No, and earlier is often better. Podcast bookings take weeks to schedule and months to air, so the conversations that land around a launch usually have to start well before it.',
          },
          {
            q: 'What kinds of authors do you work with?',
            a: 'Self-help authors. I\'m deliberately not carving that up further right now — traditionally published, hybrid, and self-published authors all have the same underlying problem, and I\'d rather find out from the work than decide in advance.',
          },
          {
            q: 'How many placements will I get?',
            a: 'It depends on the book, the timing, and the fit. On the call I\'ll tell you which kinds of shows and newsletters I think are right for you, and we\'ll set expectations from there.',
          },
          {
            q: 'Do you work with authors outside the US?',
            a: 'Yes. I\'m based in Italy and the shows and newsletters I work with are English-language and global.',
          },
          {
            q: 'What does the call involve?',
            a: 'A conversation about your book, who it\'s for, and where you\'re trying to get. If I\'m not the right person, I\'ll tell you, and where I can I\'ll point you at who is.',
          },
        ].map(item => (
          <div class="faq-item">
            <h3 class="faq-q">{item.q}</h3>
            <p class="faq-a">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .eyebrow {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #E0941A;
    margin-bottom: 0.625rem;
  }

  .eyebrow--amber { color: #E0941A; }
  .accent { font-style: italic; color: #E0941A; }

  /* Hero */
  .services-hero { background: linear-gradient(135deg, #FFFDF7 0%, #FFF8EC 100%); text-align: center; }

  .services-hero-heading {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 700;
    color: #3A3530;
    margin: 0.5rem auto 1.25rem;
    line-height: 1.15;
  }

  .services-hero-sub {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #4B5563;
    max-width: 52ch;
    margin: 0 auto;
  }

  /* Tier sections */
  .tier-section--light { background: #fff; }
  .tier-section--warm { background: #FFF8EC; }
  .tier-section--dark { background: #3A3530; }

  .tier-inner {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 4rem;
    align-items: center;
  }

  .tier-inner--reverse { grid-template-columns: 380px 1fr; }

  /* Tier content */
  .tier-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: #3A3530;
    margin: 0 0 0.25rem;
  }

  .tier-heading--light { color: #fff; }

  .tier-tagline {
    font-size: 1rem;
    font-weight: 600;
    color: #E0941A;
    margin: 0 0 1rem;
  }

  .tier-tagline--amber { color: #E0941A; }

  .tier-body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #374151;
    margin: 0 0 1.5rem;
  }

  .tier-body--light { color: #D1D5DB; }

  .tier-includes-heading {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: #3A3530;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tier-includes-heading--light { color: #9CA3AF; }

  .tier-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tier-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: 0.9375rem;
    color: #374151;
  }

  .tier-list li::before {
    content: '✓';
    color: #E0941A;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 0.05em;
  }

  .tier-list--light li { color: #D1D5DB; }

  .tier-ideal {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #6B7280;
    background: #F9FAFB;
    border-left: 3px solid #E0941A;
    border-radius: 0 0.5rem 0.5rem 0;
    padding: 0.875rem 1rem;
  }

  .tier-ideal strong { color: #3A3530; }

  .tier-ideal--dark {
    background: rgba(255,255,255,0.05);
    color: #9CA3AF;
  }

  .tier-ideal--dark strong { color: #E5E7EB; }

  /* Visuals */
  .tier-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    border-radius: 1.5rem;
    padding: 3rem 2rem;
    min-height: 280px;
  }

  .tier-visual--diy { background: #FFF8EC; border: 2px dashed rgba(224,148,26,0.3); }
  .tier-visual--consulting { background: #fff; border: 1px solid #E5E7EB; box-shadow: 0 4px 24px rgba(0,0,0,0.05); }
  .tier-visual--dfy { border: 1px solid rgba(255,255,255,0.1); flex-direction: column; gap: 1.5rem; }

  .tier-icon { font-size: 3.5rem; }
  .tier-visual-label { font-family: var(--font-heading); font-size: 1rem; font-weight: 700; color: #3A3530; }
  .tier-visual-label--light { color: #9CA3AF; }

  /* DFY steps */
  .dfy-steps {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 100%;
    max-width: 220px;
  }

  .dfy-step {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 1rem;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 0.5rem;
  }

  .dfy-step-num {
    width: 1.5rem;
    height: 1.5rem;
    background: #E0941A;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .dfy-step-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #E5E7EB;
  }

  /* FAQ */
  .services-faq { background: #fff; }

  .faq-header { text-align: center; margin-bottom: 3rem; }

  .faq-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    font-weight: 700;
    color: #3A3530;
    margin: 0;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .faq-item {
    background: #FFF8EC;
    border: 1px solid rgba(224,148,26,0.15);
    border-radius: 1rem;
    padding: 1.75rem;
  }

  .faq-q {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    color: #3A3530;
    margin: 0 0 0.75rem;
  }

  .faq-a {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #4B5563;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 960px) {
    .tier-inner,
    .tier-inner--reverse { grid-template-columns: 1fr; gap: 2.5rem; }
    .tier-inner--reverse .tier-visual { order: -1; }
    .faq-grid { grid-template-columns: 1fr; }
  }
</style>

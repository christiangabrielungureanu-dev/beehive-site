---
import BaseLayout from '../layouts/BaseLayout.astro';
import AudienceLanding from '../components/AudienceLanding.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Business Book Marketing & Publishing',
  serviceType: 'Book marketing and publishing',
  url: new URL('/business', Astro.site).href,
  provider: { '@id': new URL('/#organization', Astro.site).href },
  areaServed: 'Worldwide',
  audience: { '@type': 'Audience', audienceType: 'business authors' },
};
import Endorsements from '../components/Endorsements.astro';
---

<BaseLayout
  title="Business Book Marketing & Publishing"
  description="Marketing and publishing help for business authors: a strategy built for your book, weekly support to carry it out, and help getting it published."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <AudienceLanding
    eyebrow="Business Book Marketing & Publishing"
    heading="You wrote a business book."
    accent="Let's get it to the right readers."
    sub="I help founders, consultants, and executives build a marketing plan around their book, then carry it out alongside the business, one week at a time."
    weekGoals={[
      { text: 'Turn a chapter three insight into a LinkedIn post', done: true },
      { text: 'Send a signed copy to ten past clients', done: true },
      { text: 'Pitch a talk to an industry conference', done: false },
      { text: 'Draft a bulk-order page for companies', done: false },
    ]}
    problems={[
      {
        icon: '📚',
        title: 'The book isn\'t working for you yet.',
        body: 'You know it should be starting conversations in your field. So far it mostly sits on the shelf.',
      },
      {
        icon: '⏳',
        title: 'Marketing keeps slipping to next week.',
        body: 'You run a business. The book matters, but there\'s always something more urgent.',
      },
      {
        icon: '🧩',
        title: 'Generic advice doesn\'t fit.',
        body: 'A lot of book marketing advice assumes you\'re a novelist. A business book reaches readers differently.',
      },
    ]}
    channelsHeading="Where business readers find their next book"
    channelsIntro="A business book helps the reader and shows them how you think. The right readers are often the people you'd want as clients, partners, or audiences, so the strategy builds on the network and industry you already have."
    channels={[
      {
        icon: '💼',
        title: 'LinkedIn',
        body: 'Where your peers and future clients already read what people in your field write.',
      },
      {
        icon: '🎙️',
        title: 'Industry podcasts',
        body: 'Shows your buyers listen to, where a guest with a book gets a natural introduction.',
      },
      {
        icon: '🎤',
        title: 'Speaking',
        body: 'Conferences, panels, and company events, where the book becomes the basis for your talk.',
      },
      {
        icon: '📦',
        title: 'Bulk orders',
        body: 'Companies buying copies for teams, events, and their own clients.',
      },
      {
        icon: '🤝',
        title: 'Your clients and network',
        body: 'People who already know your work and will pass on a book that explains it well.',
      },
      {
        icon: '📰',
        title: 'Trade publications',
        body: 'Articles and columns in the outlets your industry actually reads.',
      },
    ]}
    faqs={[
      {
        q: 'I\'m busy running a company. How much time does this take?',
        a: 'The weekly goals are sized to the time you actually have. A few things done consistently beat everything done once.',
      },
      {
        q: 'Can the book help my business, not just sell copies?',
        a: 'That\'s usually the point. On the call I\'ll ask what you want the book to do for your business, and the plan starts from there.',
      },
      {
        q: 'Can my team help carry out the plan?',
        a: 'Yes. Weekly goals can be shared with an assistant or marketing team. You stay the face of the book; they can handle the rest.',
      },
      {
        q: 'I\'m traditionally published. Can you still help?',
        a: 'Yes. The publishing services won\'t apply, but the marketing work does. Self-published and hybrid authors are welcome too.',
      },
      {
        q: 'How much does it cost?',
        a: 'It depends on what you need. I\'ll walk you through the options and pricing on the call.',
      },
    ]}
  >
    <Endorsements />
  </AudienceLanding>
</BaseLayout>
